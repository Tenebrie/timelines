# Build stage
FROM node:26-alpine AS builder

WORKDIR /app

# Copy and build ts-shared first
COPY ./app/ts-shared /app/ts-shared
RUN cd /app/ts-shared && npm ci

# Build every local library, then prune to production deps
COPY ./library /library
RUN for d in /library/*/; do if [ -f "$d/package.json" ]; then (cd "$d" && npm ci && npm run build && npm prune --omit=dev); fi; done

# Copy package files and install ALL dependencies (needed for build)
COPY ./app/calliope-websockets/package.json ./app/calliope-websockets/package-lock.json /app/calliope/
WORKDIR /app/calliope
RUN npm ci

# Copy source files and build
COPY ./app/calliope-websockets /app/calliope
RUN npm run build

# Production stage
FROM node:26-alpine

WORKDIR /app/calliope

# Copy only the built JavaScript
COPY --from=builder /app/calliope/dist /app/calliope/dist
COPY --from=builder /app/calliope/package.json /app/calliope/package-lock.json /app/calliope/

# Copy only ts-shared source (no node_modules)
COPY ./app/ts-shared/package.json /app/ts-shared/package.json
COPY ./app/ts-shared/src /app/ts-shared/src

# Copy built libraries
COPY --from=builder /library /library

# Install ONLY production dependencies
RUN npm ci --omit=dev && npm cache clean --force

EXPOSE 3000